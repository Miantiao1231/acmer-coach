{
  "name": "acmer-coach",
  "description": "dsh 小鲸算法教练：目标驱动的长期训练、VP回放、证据验收与可选Hindsight记忆桥。随包提供人设和预设，记忆桥配置自己的服务与bank后启用。",
  "version": "2.12.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miantiao1231/acmer-coach.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  },
  "scripts": {
    "test": "node dev/run-tests.mjs",
    "eval:teaching": "node dev/teaching-eval.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
